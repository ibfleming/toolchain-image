{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "customManagers:dockerfileVersions", ":semanticCommits"],
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Image toolchain manifests (ci + dev): build(toolchain)",
      "matchManagers": ["mise"],
      "matchFileNames": ["toolchain/**"],
      "semanticCommitType": "build",
      "semanticCommitScope": "toolchain"
    },
    {
      "description": "Repo lint/test tooling (root mise.toml): chore(deps)",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Base image digest and Dockerfile-pinned versions: build(image)",
      "matchManagers": ["dockerfile", "custom.regex"],
      "semanticCommitType": "build",
      "semanticCommitScope": "image"
    },
    {
      "description": "GitHub Actions: ci(actions), pinned to commit SHAs",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions"
    },
    {
      "description": "Python stays one minor behind the newest release: minor bumps need dashboard approval",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Major bumps change the image contract (semver major): approve explicitly",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "zsh plugins pinned by tag + commit in config/zsh/plugins.txt: both are updated together",
      "managerFilePatterns": ["/(^|/)config/zsh/plugins\\.txt$/"],
      "matchStrings": ["(?<name>\\S+) (?<depName>[\\w.-]+/[\\w.-]+) (?<currentValue>\\S+) (?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "npm CLIs the test scripts run with npx, annotated `# renovate: datasource=npm depName=<package>` above `readonly NAME=\"<package>@<version>\"`",
      "managerFilePatterns": ["/(^|/)tests/[^/]+\\.sh$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nreadonly \\w+=\"\\S+@(?<currentValue>[^\"@]+)\""]
    }
  ]
}
