// Template .devcontainer/devcontainer.json for repositories that use the toolchain `dev` image.
// Copy it into a repo and adjust. The image already provides remoteUser (vscode), zsh, editor
// extensions and settings through its devcontainer.metadata label; this file holds only what is
// per-repository, and anything here overrides the image (see docs/customizing.md).
{
  "name": "my-project",

  // Pin by digest (registry tags are mutable); let Renovate/Dependabot bump it.
  // Replace <owner>, <version> and <digest> with a published release (see the GitHub Release notes).
  "image": "ghcr.io/<owner>/toolchain/dev:<version>@sha256:<digest>",

  "mounts": [
    // Per-project Claude Code state (CLAUDE_CONFIG_DIR): sessions, history, settings edits.
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    // zsh history across rebuilds.
    "source=zsh-state-${devcontainerId},target=/home/vscode/.local/state/zsh,type=volume"

    // Optional: personal dotfiles from a local clone, mounted READ-ONLY so the container can't
    // modify them and needs no Git credentials (pair with the postStartCommand below).
    // "source=${localEnv:HOME}/dotfiles,target=/home/vscode/.dotfiles,type=bind,readonly"
  ]

  // Optional: apply those dotfiles on every start (idempotent; edits apply without a rebuild).
  // "postStartCommand": "/home/vscode/.dotfiles/install.sh",

  // Optional: Claude Code auth without an interactive /login. Store `claude setup-token` output as
  // CLAUDE_CODE_OAUTH_TOKEN=<token> in a 0600 file outside any repository. Container creation
  // fails if the file is missing. Alternatively run /login once inside the container; the
  // claude-code-config volume keeps it.
  // "runArgs": ["--env-file", "${localEnv:HOME}/.config/claude-code/container.env"],

  // Per-repo editor overrides, e.g. drop an image extension or change a setting:
  // "customizations": { "vscode": { "extensions": ["-golang.go"], "settings": {} } }
}
