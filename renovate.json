{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "customManagers:dockerfileVersions", ":semanticCommits"],
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "customDatasources": {
    "claude-code-stable": {
      "defaultRegistryUrlTemplate": "https://downloads.claude.ai/claude-code-releases/stable",
      "format": "plain"
    }
  },
  "packageRules": [
    {
      "description": "Image toolchain manifests (ci + dev): build(toolchain)",
      "matchManagers": ["mise"],
      "matchFileNames": ["toolchain/**"],
      "semanticCommitType": "build",
      "semanticCommitScope": "toolchain"
    },
    {
      "description": "Repo lint/test tooling (root mise.toml): chore(deps)",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Base image digest and Dockerfile-pinned versions: build(image)",
      "matchManagers": ["dockerfile", "custom.regex"],
      "semanticCommitType": "build",
      "semanticCommitScope": "image"
    },
    {
      "description": "GitHub Actions: ci(actions), pinned to commit SHAs",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions"
    },
    {
      "description": "Python stays one minor behind the newest release: minor bumps need dashboard approval",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Major bumps change the image contract (semver major): approve explicitly",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Dockerfile deps pinned by tag + commit (`# renovate: ... pin=commit`): both are updated together",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) pin=commit\\s+ARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)\\s+ARG [A-Z0-9_]+_COMMIT=(?<currentDigest>[0-9a-f]{40})"]
    }
  ]
}
