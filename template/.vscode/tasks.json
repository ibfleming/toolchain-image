// Shared tasks: Terminal → Run Task. Add the project's build, test and run commands here.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Container: status",
      "detail": "Lifecycle state of this dev container (dev-status)",
      "type": "shell",
      "command": "dev-status",
      "problemMatcher": []
    },
    {
      "label": "Container: reinstall dependencies",
      "detail": "Run post-create again from scratch, then the start checks (marks the container ready)",
      "type": "shell",
      "command": ".devcontainer/scripts/post-start.sh",
      "dependsOn": ["Container: post-create again"],
      "problemMatcher": []
    },
    {
      "label": "Container: re-run start checks",
      "detail": "Run post-start again: the readiness checks (marks the container ready)",
      "type": "shell",
      "command": ".devcontainer/scripts/post-start.sh",
      "problemMatcher": []
    },
    {
      // A step of "reinstall dependencies"; on its own it would leave the container not ready.
      "label": "Container: post-create again",
      "type": "shell",
      "command": "dev-reset dependencies && .devcontainer/scripts/post-create.sh",
      "hide": true,
      "problemMatcher": []
    }
    // {
    //   "label": "test",
    //   "type": "shell",
    //   "command": "make test",
    //   "group": { "kind": "test", "isDefault": true },
    //   "problemMatcher": []
    // }
  ]
}
